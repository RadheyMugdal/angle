{
  "name": "angle-io",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@neondatabase/serverless": "^1.2.0",
      "@trpc/server": "^11.18.0",
      "@trpc/client": "^11.18.0",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "tailwindcss": "^4.3.3",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @angle-io/db --",
    "db:local": "turbo run db:local -F @angle-io/db --",
    "db:migrate": "turbo run db:migrate -F @angle-io/db --",
    "db:push": "turbo run db:push -F @angle-io/db --",
    "db:studio": "turbo run db:studio -F @angle-io/db --",
    "deploy": "bunx vercel deploy",
    "deploy:check": "bunx vercel deploy --dry",
    "deploy:prod": "bunx vercel deploy --prod",
    "deploy:setup": "bunx vercel link",
    "dev": "turbo run dev",
    "dev:vercel": "bunx vercel dev -L",
    "dev:web": "turbo run dev -F web --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "env:preview": "tsx scripts/sync-vercel-env.ts preview",
    "env:production": "tsx scripts/sync-vercel-env.ts production",
    "fix": "ultracite fix",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/"
  },
  "overrides": {
    "@next/env": "npm:@varlock/nextjs-integration@1.2.2"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@angle-io/config": "workspace:*",
    "@biomejs/biome": "2.5.12",
    "@types/node": "catalog:",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.3"
}
